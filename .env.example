# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ENV=preview
NEXT_TELEMETRY_DISABLED=1

# Formspree submission endpoints. Use the full https://formspree.io/f/{form_id} URL.
# FORMSPREE_ENDPOINT may be shared by normal forms; per-form values override it.
# Concern reports intentionally require their own endpoint.
FORMSPREE_ENDPOINT=
FORMSPREE_ENDPOINT_CHALLENGE=
FORMSPREE_ENDPOINT_BUILDER_INTEREST=
FORMSPREE_ENDPOINT_LIBERATION_INTEREST=
FORMSPREE_ENDPOINT_PARTNERSHIP_INQUIRY=
FORMSPREE_ENDPOINT_GENERAL_CONTACT=
FORMSPREE_ENDPOINT_CONCERN_REPORT=

# Optional Google Analytics 4. Leave empty to load no analytics script.
# Configure only after reviewing the GA4 property privacy settings in docs/analytics-and-consent.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
